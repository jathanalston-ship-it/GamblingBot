# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Secrets & local config — NEVER commit real credentials. Secrets live in .env
# (under MRP_USER_DIR at runtime); the only tracked env file is .env.example.
.env
.env.*
!.env.example
# Runtime provider selection (non-secret, but local state — keep it out of git).
settings.yaml
config/settings.yaml

# Data & databases (never commit market data or the research DB)
data/raw/
data/processed/
data/cache/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.parquet

# Reports / artifacts (keep the dir, ignore generated contents)
reports/*
!reports/.gitkeep
*.html
!docs/**/*.html

# Logs (keep the dir, ignore log files)
logs/*
!logs/.gitkeep

# Notebooks
.ipynb_checkpoints/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Desktop installer assets: track the build sources (icon, spec, scripts) and the
# Vite entry HTML, but ignore generated build output. (Overrides build/ and *.html.)
!desktop/build/
desktop/build/backend/
desktop/build/.pyiwork/
!desktop/renderer/index.html

# Development Mode (`npm run dev-app`) isolated state: DB, logs, settings.
.dev/
