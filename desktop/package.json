{
  "name": "momentum-lab-desktop",
  "version": "0.0.22",
  "private": true,
  "description": "Momentum Lab — desktop application (Electron + React + FastAPI).",
  "author": "Momentum Lab",
  "main": "dist-electron/main.js",
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "npm --workspace renderer run dev",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "npm --workspace renderer run build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "package": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "icon": "python build/make_icon.py",
    "lint": "npm --workspace renderer run lint",
    "typecheck": "npm --workspace renderer run typecheck && tsc -p electron/tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  }
}
