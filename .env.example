# Momentum Lab — environment template.
#
# Copy to `.env` and fill in. NEVER commit real secrets — `.env` is git-ignored;
# only this `.env.example` (with empty values) is tracked. At runtime the desktop
# app stores `.env` under MRP_USER_DIR (e.g. %APPDATA%\Momentum Lab).
#
# Secrets come ONLY from the environment (this file → the process env). Tunables
# live in config/*.yaml. The backend validates required secrets at startup and
# prints a clear, value-free error if any are missing (see docs/SECRETS.md).

# ── Mode ───────────────────────────────────────────────────────────────────────
MRP_ENV=research                 # research | paper | live  (live requires BROKER_* below)

# ── SECRETS ────────────────────────────────────────────────────────────────────
# Market-data provider credentials (only the provider you actually select is
# required; the default provider `yfinance` needs none).
ALPACA_API_KEY=                  # required when data.provider = alpaca
ALPACA_API_SECRET=               # required when data.provider = alpaca
POLYGON_API_KEY=                 # required when data.provider = polygon

# Broker credentials (required only when MRP_ENV = live).
BROKER_API_KEY=
BROKER_API_SECRET=

# Optional: a GitHub token so the packaged app's auto-update can read a PRIVATE
# repo's release feed. Leave blank for a public repo. (See docs/AUTO_UPDATE_AUDIT.md.)
MRP_UPDATE_TOKEN=

# ── NON-SECRET CONFIG (safe defaults; override if needed) ──────────────────────
BROKER_BASE_URL=https://paper-api.alpaca.markets   # public Alpaca paper endpoint
DATABASE_URL=sqlite:///data/momentum.db
API_HOST=127.0.0.1
API_PORT=8000

# Make missing required secrets a HARD startup error (operator/CI). Default: off,
# so the desktop app still boots to Settings where keys can be entered.
# MRP_STRICT_SECRETS=1
