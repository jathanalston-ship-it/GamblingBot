# Copy to .env and fill in. NEVER commit real secrets.
# Secrets stay in the environment; tunables live in config/*.yaml.

MRP_ENV=research                 # research | paper | live

# Market-data provider credentials (only the one you use is required)
ALPACA_API_KEY=
ALPACA_API_SECRET=
POLYGON_API_KEY=

# Broker credentials (paper/live execution)
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=https://paper-api.alpaca.markets

# Storage
DATABASE_URL=sqlite:///data/momentum.db

# API service
API_HOST=127.0.0.1
API_PORT=8000
